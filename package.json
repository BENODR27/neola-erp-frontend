{
  "name": "frontend",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local --proxy-config proxy.local.json --prebundle=false --host=127.0.0.1 --port=4201",
    "start:mmms-test": "ng serve --configuration mmms-test --prebundle=false --proxy-config proxy.mmms-test.json",
    "start:all": "npm run start",
    "build": "npm run build:production",
    "build:test": "ng build --configuration development --output-path dist/frontend-test",
    "build:production": "ng build --configuration production --output-path dist/frontend-release",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:mmms": "node --test tools/mmms-export.test.cjs tools/mmms-qr.test.cjs tools/mmms-pagination.test.cjs",
    "test:appearance": "node --test tools/appearance.test.cjs",
    "test:navigation": "node --test tools/workspace-navigation.test.cjs",
    "lint": "ng lint",
    "format": "prettier --write \"*.{json,mjs,cjs,md}\" \"docs/**/*.md\" \"src/app/shared/config/**/*.ts\" \"src/app/shared/environments/**/*.ts\"",
    "format:check": "prettier --check \"*.{json,mjs,cjs,md}\" \"docs/**/*.md\" \"src/app/shared/config/**/*.ts\" \"src/app/shared/environments/**/*.ts\"",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs src",
    "validate": "npm run format:check && npm run lint && npm run architecture:check && npm run build",
    "prepare": "husky",
    "build:docker": "ng build --configuration production,docker --output-path dist/frontend-docker",
    "test:auth": "node --test tools/auth-session.test.cjs",
    "docker:config": "docker compose --env-file .env.deploy -f compose.independent.yaml config --quiet",
    "docker:build": "docker compose --env-file .env.deploy -f compose.independent.yaml build",
    "docker:up": "docker compose --env-file .env.deploy -f compose.independent.yaml up -d --build",
    "docker:logs": "docker compose --env-file .env.deploy -f compose.independent.yaml logs --tail=100 -f"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,html,css,scss,json,md}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@mdi/font": "^7.4.47",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "@zxing/ngx-scanner": "22.0.1",
    "angularx-qrcode": "22.0.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.7",
    "crypto-js": "^4.2.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "marked": "^17.0.0",
    "material-icons": "^1.13.14",
    "primeng": "22.1.4",
    "roboto-fontface": "^0.10.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.14.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.6",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "16.2.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
